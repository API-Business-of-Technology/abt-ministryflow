{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "mutate": [
    "backend_*/src/**/*.ts",
    "frontend_*/src/**/*.tsx"
  ],
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dossier_test/**"
  ]
}
