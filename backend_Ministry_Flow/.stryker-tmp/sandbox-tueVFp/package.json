{
  "name": "backend_ministry_flow",
  "version": "1.0.0",
  "description": "Backend du logiciel Ministry_Flow. Cette version est MVP.",
  "keywords": [
    "ministryflow",
    "react",
    "nextjs",
    "nodejs",
    "express",
    "jest",
    "cypress",
    "devops",
    "prometheus",
    "grafana",
    "terraform",
    "ansible",
    "sonarQube",
    "ci-cd"
  ],
  "homepage": "https://gitlab.com/apibusinesstechnology-group/depot_ministryflow#readme",
  "bugs": {
    "url": "https://gitlab.com/apibusinesstechnology-group/depot_ministryflow/issues"
  },
  "repository": {
    "type": "gitlab",
    "url": "git+https://gitlab.com/apibusinesstechnology-group/depot_ministryflow.git"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "API Business Technology",
  "type": "module",
  "main": "server.js",
  "scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",

  "lint": "eslint . --ext .js,.ts,.tsx --fix",
  "format": "prettier --write .",

  "test": "jest --ci",
  "test:unit": "jest --runTestsByPath dossier_test/unit_test",
  "test:integration": "jest --runTestsByPath dossier_test/integration_test",
  "test:coverage": "jest --coverage",
  "test:sentinel": "jest dossier_test/regression_test/sentinel/all_test_ok.test.ts",
  "test:all": "npm run test && npm run test:coverage && npm run test:sentinel",

  "mutate": "stryker run",
  "sonar": "sonar-scanner",

  "prepare": "husky install"
},

  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "nodemon": "^3.1.14"
  }
}
